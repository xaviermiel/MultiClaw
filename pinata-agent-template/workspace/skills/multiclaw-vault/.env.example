# LLM provider — set in the Pinata Secrets Vault, never commit a real value
ANTHROPIC_API_KEY=

# Agent signer: the EOA authorized as the vault's agentAddress.
# Low-privilege by design — on-chain caps bound its blast radius if leaked.
AGENT_PRIVATE_KEY=

# Deployed DeFiInteractorModule for this agent's vault (Base Sepolia)
VAULT_MODULE_ADDRESS=

# Optional: chain name — baseSepolia (default) or base
MULTICLAW_CHAIN=baseSepolia

# Optional: Base Sepolia RPC override (defaults to https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=
