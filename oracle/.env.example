# MultiClaw oracle configuration.
#
# Copy to .env for `bin/oracle run` (or `npm start`, the legacy TS oracle),
# or to /etc/multiclaw-oracle/oracle.env for deploy/multiclaw-oracle.service.
# systemd reads that file too and does not strip trailing comments: keep
# comments on their own lines and quote values that contain spaces.
#
# An empty value counts as unset. Commented-out values are the defaults
# (per chain where noted: Base and Base Sepolia / Sepolia). [Go] marks the
# variables only the Go oracle reads.

# ---- Chain and RPC ----

# sepolia | base | base-sepolia (default: sepolia)
CHAIN=base-sepolia

# RPC endpoint (default: the chain's public endpoint). It must accept
# eth_getLogs over MAX_BLOCKS_PER_QUERY blocks: the public sepolia.base.org
# only takes 200, so set MAX_BLOCKS_PER_QUERY=200 there.
RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# More endpoints, comma-separated, used in turn when one fails. Every
# endpoint must serve CHAIN.
# RPC_FALLBACK_URLS=https://rpc2.example.com,https://rpc3.example.com

# ---- Oracle identity ----

# Private key of the address set as the modules' authorizedOracle.
PRIVATE_KEY=0x...

# [Go] Simulate and log every transaction instead of signing and sending it
# (also the --dry-run flag).
# DRY_RUN=false

# [Go] The oracle's address. With DRY_RUN=true it replaces PRIVATE_KEY, so a
# dry run needs no key; when both are set they must match.
# ORACLE_ADDRESS=0x...

# ---- Modules ----

# ModuleRegistry: the oracle serves its active modules whose authorizedOracle
# is this oracle.
REGISTRY_ADDRESS=0x...

# A single module: served when REGISTRY_ADDRESS is unset, or lists no module
# or cannot be read.
# MODULE_ADDRESS=0x...

# ---- Schedules ----

# Cron expressions, 5 fields or 6 with seconds first.
# Safe value check.
# SAFE_VALUE_CRON="0 */10 * * * *"
# Spending oracle refresh of every subaccount.
# SPENDING_ORACLE_CRON="0 */2 * * * *"

# Spending oracle event polling, every 2 block times (4000 / 24000).
# POLL_INTERVAL_MS=4000

# ---- Block ranges ----

# Blocks the first poll reads; each subaccount's state is rebuilt from twice
# as many (24 hours of blocks: 43200 / 7200).
# BLOCKS_TO_LOOK_BACK=43200

# Blocks behind the head that are not processed yet, against reorgs (3 / 12).
# CONFIRMATION_BLOCKS=3

# Largest block range of one eth_getLogs.
# MAX_BLOCKS_PER_QUERY=5000

# Blocks of AcquiredBalanceUpdated events searched for acquired balances to
# clear (30 days of blocks: 1296000 / 216000).
# MAX_HISTORICAL_BLOCKS=1296000

# ---- Update thresholds ----

# The Safe value is written when it moved more than this...
# SAFE_VALUE_CHANGE_THRESHOLD_BPS=100
# ...or the on-chain value is older than this.
# SAFE_VALUE_MAX_STALENESS_SECONDS=2700

# A subaccount's update is pushed when its allowance decreased, increased by
# more than this, or its acquired balances changed...
# ALLOWANCE_INCREASE_THRESHOLD_BPS=200
# ...or its last update is older than this (or the oracle just started).
# SPENDING_ORACLE_MAX_STALENESS_SECONDS=2700

# ---- Transactions ----

# Gas limit of every oracle transaction.
# GAS_LIMIT=500000
